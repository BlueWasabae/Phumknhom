PORT=2567
HOST=0.0.0.0
NODE_ENV=development

# Allowed browser origins (comma-separated) in addition to localhost:5173 & bluexacedamy.space
CLIENT_ORIGIN=https://www.bluexacedamy.space

# Optional: Paste your Supabase Project URL and Service Role Key to enable cloud Postgres persistence.
# When left blank, the server automatically falls back to local JSON persistence at server/data/local_db.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign stateless auth session tokens (use a strong 32+ char secret in production)
AUTH_SECRET=phum-khnhom-local-dev-secret

# Optional: Payment Provider Webhook Secrets (Phase 10 Live IAP)
STRIPE_WEBHOOK_SECRET=
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
